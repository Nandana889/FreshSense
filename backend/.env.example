# Copy this file to .env and fill in your key.
#   cp .env.example .env
#
# A real environment variable overrides whatever is in .env.
# Without a key the app still runs: the advisor falls back to the deterministic
# rules engine, and follow-up questions are hidden.

ANTHROPIC_API_KEY=sk-ant-...

# Extra browser origins allowed to call this API, comma-separated.
# http://localhost:5173 and http://127.0.0.1:5173 are always allowed; add the
# deployed frontend's URL here when the page is not served locally.
#   ALLOWED_ORIGINS=https://freshsense.vercel.app
ALLOWED_ORIGINS=
